# Public site URL used for metadata, sitemap, and structured data.
# Example: https://muzyhr.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Leave these unset to keep the contact form in demonstration mode.
# Nothing is emailed or stored until all three values are present.
# CONTACT_TO_EMAIL must be a real inbox Tamara has confirmed.
# RESEND_FROM_EMAIL must be a sender verified in Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
RESEND_FROM_EMAIL=
